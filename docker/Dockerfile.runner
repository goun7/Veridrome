# Veridrome TEE Runner: Multi-Stage Secure Container
FROM python:3.12-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Sistem bağımlılıkları ve Chromium kütüphaneleri
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    git \
    libfaketime \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Çalışma dizini ve izinler
WORKDIR /app

# Bağımlılıkların yüklenmesi
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir .
RUN playwright install --with-deps chromium

# Güvenli kullanıcı oluşturma (Non-root containment)
RUN useradd -m -u 1001 -s /bin/bash veridrome && \
    chown -R veridrome:veridrome /app /ms-playwright

USER veridrome

# Uygulama kodunun kopyalanması
COPY src/ /app/src/
COPY contracts/ /app/contracts/

ENV PYTHONPATH=/app/src

EXPOSE 8000

CMD ["uvicorn", "veridrome.server.api:app", "--host", "0.0.0.0", "--port", "8000"]
